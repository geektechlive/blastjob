# Copy to <data dir>/secrets.env (default ~/.blastjob/secrets.env, or wherever the
# paths.secrets_file setting points) and chmod 600. blastjob loads it at runtime
# (src/blastjob/secrets.py); a variable already set in your shell always wins.
# Every key is OPTIONAL: with none set, all LLM work runs through a logged-in
# `claude` CLI and discovery uses keyless public ATS boards.

# LLM provider (pick one, or neither to use the claude CLI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Company research + people search (free tier at jina.ai)
JINA_API_KEY=

# Adzuna aggregator (free key at developer.adzuna.com; also set
# [discovery] enable_aggregators = true)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Daily Discord digest (a bot you create + the channel id it posts to)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# LinkedIn/Indeed job-alert mailbox over IMAP (app-specific password, never your
# real one). These names are the config defaults; rename them in /settings.
ICLOUD_IMAP_USER=
ICLOUD_IMAP_APP_PASSWORD=
