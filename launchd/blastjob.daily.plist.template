<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL_PREFIX__.blastjob.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/run-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <!--ENV-->
  <key>EnvironmentVariables</key>
  <dict>
    <key>BLASTJOB_DATA_DIR</key>
    <string>__DATA_DIR__</string>
  </dict>
  <!--/ENV-->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/daily.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/daily.launchd.log</string>
</dict>
</plist>
