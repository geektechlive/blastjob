<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL_PREFIX__.blastjob.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/run-web.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!--ENV-->
  <key>EnvironmentVariables</key>
  <dict>
    <key>BLASTJOB_DATA_DIR</key>
    <string>__DATA_DIR__</string>
  </dict>
  <!--/ENV-->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/web.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/web.launchd.log</string>
</dict>
</plist>
